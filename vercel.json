{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "feiri-landing.vercel.app" }],
      "destination": "https://drop.feiri.co.za/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "feiri-landing.vercel.app" }],
      "destination": "https://drop.feiri.co.za/:path*",
      "permanent": false
    }
  ]
}
